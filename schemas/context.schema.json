{
  "$defs": {
    "Analysis": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.2",
          "default": "1.2",
          "title": "Schema Version",
          "type": "string"
        },
        "analysis_id": {
          "title": "Analysis Id",
          "type": "string"
        },
        "config_hash": {
          "title": "Config Hash",
          "type": "string"
        },
        "repositories": {
          "items": {
            "$ref": "#/$defs/RepositoryRevision"
          },
          "title": "Repositories",
          "type": "array"
        },
        "symbols": {
          "items": {
            "$ref": "#/$defs/Symbol"
          },
          "title": "Symbols",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/Dependency"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "endpoints": {
          "items": {
            "$ref": "#/$defs/Endpoint"
          },
          "title": "Endpoints",
          "type": "array"
        },
        "calls": {
          "items": {
            "$ref": "#/$defs/Call"
          },
          "title": "Calls",
          "type": "array"
        },
        "relations": {
          "items": {
            "$ref": "#/$defs/Relation"
          },
          "title": "Relations",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "comparisons": {
          "items": {
            "$ref": "#/$defs/Comparison"
          },
          "title": "Comparisons",
          "type": "array"
        },
        "type_comparisons": {
          "items": {
            "$ref": "#/$defs/TypeComparison"
          },
          "title": "Type Comparisons",
          "type": "array"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        }
      },
      "required": [
        "analysis_id",
        "config_hash",
        "repositories",
        "symbols",
        "evidence",
        "dependencies",
        "endpoints",
        "calls",
        "relations",
        "findings",
        "comparisons",
        "coverage"
      ],
      "title": "Analysis",
      "type": "object"
    },
    "BodyRequirement": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "known",
            "unknown",
            "none"
          ],
          "title": "Status",
          "type": "string"
        },
        "fields": {
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "status"
      ],
      "title": "BodyRequirement",
      "type": "object"
    },
    "Call": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "symbol_id": {
          "title": "Symbol Id",
          "type": "string"
        },
        "repository_id": {
          "title": "Repository Id",
          "type": "string"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Method"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "body": {
          "$ref": "#/$defs/RequestBody"
        },
        "types": {
          "$ref": "#/$defs/TypeContract"
        }
      },
      "required": [
        "id",
        "symbol_id",
        "repository_id",
        "method",
        "url",
        "evidence_id",
        "body"
      ],
      "title": "Call",
      "type": "object"
    },
    "Comparison": {
      "additionalProperties": false,
      "properties": {
        "relation_id": {
          "title": "Relation Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "missing",
            "no_omission",
            "unknown",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "title": "Finding Ids",
          "type": "array"
        }
      },
      "required": [
        "relation_id",
        "status",
        "reason"
      ],
      "title": "Comparison",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "confirmed": {
          "items": {
            "type": "string"
          },
          "title": "Confirmed",
          "type": "array"
        },
        "candidates": {
          "items": {
            "type": "string"
          },
          "title": "Candidates",
          "type": "array"
        },
        "unresolved_calls": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved Calls",
          "type": "array"
        },
        "gaps": {
          "items": {
            "$ref": "#/$defs/Gap"
          },
          "title": "Gaps",
          "type": "array"
        }
      },
      "required": [
        "confirmed",
        "candidates",
        "unresolved_calls",
        "gaps"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "Dependency": {
      "additionalProperties": false,
      "properties": {
        "from_symbol": {
          "title": "From Symbol",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "kind": {
          "enum": [
            "import",
            "using"
          ],
          "title": "Kind",
          "type": "string"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        }
      },
      "required": [
        "from_symbol",
        "target",
        "kind",
        "evidence_id"
      ],
      "title": "Dependency",
      "type": "object"
    },
    "Endpoint": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "symbol_id": {
          "title": "Symbol Id",
          "type": "string"
        },
        "repository_id": {
          "title": "Repository Id",
          "type": "string"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "route": {
          "title": "Route",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "request": {
          "$ref": "#/$defs/BodyRequirement"
        },
        "types": {
          "$ref": "#/$defs/TypeContract"
        }
      },
      "required": [
        "id",
        "symbol_id",
        "repository_id",
        "method",
        "route",
        "evidence_ids",
        "request"
      ],
      "title": "Endpoint",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "repository_id": {
          "title": "Repository Id",
          "type": "string"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "id": {
          "pattern": "^ev-[a-f0-9]{24}$",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
          "title": "Revision",
          "type": "string"
        },
        "source_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Hash",
          "type": "string"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "file",
        "start_line",
        "end_line",
        "id",
        "revision",
        "source_hash",
        "symbol"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^finding-[a-f0-9]{24}$",
          "title": "Id",
          "type": "string"
        },
        "code": {
          "default": "missing_required_field",
          "enum": [
            "missing_required_field",
            "incompatible_type"
          ],
          "title": "Code",
          "type": "string"
        },
        "relation_id": {
          "title": "Relation Id",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "relation_id",
        "field",
        "explanation",
        "evidence_ids"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Gap": {
      "additionalProperties": false,
      "properties": {
        "repository_id": {
          "title": "Repository Id",
          "type": "string"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Call Id"
        }
      },
      "required": [
        "repository_id",
        "file",
        "code"
      ],
      "title": "Gap",
      "type": "object"
    },
    "Module": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "relation_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Relation Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "relation_ids"
      ],
      "title": "Module",
      "type": "object"
    },
    "Relation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "endpoint_id": {
          "title": "Endpoint Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "confirmed",
            "candidate"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "id",
        "call_id",
        "endpoint_id",
        "status",
        "reason"
      ],
      "title": "Relation",
      "type": "object"
    },
    "RepositoryRevision": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "title": "RepositoryRevision",
      "type": "object"
    },
    "RequestBody": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "object",
            "unknown",
            "none"
          ],
          "title": "Status",
          "type": "string"
        },
        "fields": {
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "status"
      ],
      "title": "RequestBody",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "path": {
          "pattern": "^sources/ev-[a-f0-9]{24}\\.txt$",
          "title": "Path",
          "type": "string"
        },
        "snippet_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Snippet Hash",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "path",
        "snippet_hash"
      ],
      "title": "Source",
      "type": "object"
    },
    "Symbol": {
      "additionalProperties": false,
      "properties": {
        "repository_id": {
          "title": "Repository Id",
          "type": "string"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "module",
            "class",
            "method",
            "function"
          ],
          "title": "Kind",
          "type": "string"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "file",
        "start_line",
        "end_line",
        "id",
        "name",
        "kind",
        "evidence_id"
      ],
      "title": "Symbol",
      "type": "object"
    },
    "TypeComparison": {
      "additionalProperties": false,
      "properties": {
        "relation_id": {
          "title": "Relation Id",
          "type": "string"
        },
        "location": {
          "enum": [
            "body",
            "query",
            "response"
          ],
          "title": "Location",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "actual": {
          "title": "Actual",
          "type": "string"
        },
        "expected": {
          "title": "Expected",
          "type": "string"
        },
        "status": {
          "enum": [
            "compatible",
            "incompatible",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Evidence Ids",
          "type": "array"
        },
        "finding_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finding Id"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "relation_id",
        "location",
        "path",
        "actual",
        "expected",
        "status",
        "reason",
        "evidence_ids",
        "explanation"
      ],
      "title": "TypeComparison",
      "type": "object"
    },
    "TypeContract": {
      "additionalProperties": false,
      "properties": {
        "facts": {
          "items": {
            "$ref": "#/$defs/TypeFact"
          },
          "title": "Facts",
          "type": "array"
        },
        "unresolved": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved",
          "type": "array"
        }
      },
      "title": "TypeContract",
      "type": "object"
    },
    "TypeFact": {
      "additionalProperties": false,
      "description": "Tipo observado na implementa\u00e7\u00e3o, com caminho JSON ou nome de par\u00e2metro.",
      "properties": {
        "location": {
          "enum": [
            "body",
            "query",
            "response"
          ],
          "title": "Location",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "kind": {
          "enum": [
            "string",
            "boolean",
            "null",
            "object",
            "array",
            "int32",
            "integer",
            "number",
            "absent",
            "unknown",
            "integer_text",
            "invalid_integer_text"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "location",
        "path",
        "kind"
      ],
      "title": "TypeFact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.2",
      "default": "1.2",
      "title": "Schema Version",
      "type": "string"
    },
    "module": {
      "$ref": "#/$defs/Module"
    },
    "analysis": {
      "$ref": "#/$defs/Analysis"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "module",
    "analysis",
    "sources"
  ],
  "title": "Context",
  "type": "object"
}
