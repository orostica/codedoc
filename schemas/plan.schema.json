{
  "$defs": {
    "Module": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "relation_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Relation Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "relation_ids"
      ],
      "title": "Module",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "analysis_id": {
      "title": "Analysis Id",
      "type": "string"
    },
    "reviewed": {
      "default": false,
      "title": "Reviewed",
      "type": "boolean"
    },
    "modules": {
      "items": {
        "$ref": "#/$defs/Module"
      },
      "title": "Modules",
      "type": "array"
    }
  },
  "required": [
    "analysis_id",
    "modules"
  ],
  "title": "Plan",
  "type": "object"
}
